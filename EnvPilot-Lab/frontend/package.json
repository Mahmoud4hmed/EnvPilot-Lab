{
  "name": "envpilot-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --webpack",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "vitest run tests/smoke.test.tsx",
    "test:exercise": "vitest run tests/dashboard.test.tsx",
    "test:e2e": "playwright test"
  },
  "dependencies": {"next": "16.4.3", "react": "19.3.1", "react-dom": "19.3.1"},
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "vitest": "5.0.5",
    "jsdom": "26.1.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/dom": "10.4.1",
    "@playwright/test": "1.58.2"
  }
}
